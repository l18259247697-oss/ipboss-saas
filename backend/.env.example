# ===== 一键追爆 SaaS 环境配置（复制为 .env 后填写）=====
# 这些值也可以登录后在【后台-设置】里改，无需改文件。

# --- 大模型 API（用于"改写文案"，OpenAI 兼容即可）---
# 豆包/DeepSeek/通义/Moonshot/OpenAI 等都兼容，填对应的 base_url 和 model
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# --- 数字人对口型（留空=用占位成片；填了=真对口型）---
# provider: none | heygem | custom
DH_PROVIDER=none
DH_BASE_URL=
DH_API_KEY=

# --- 计费 ---
CREDITS_PER_VIDEO=10
REGISTER_BONUS=30

# --- 管理员账号（首次启动自动创建）---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin888
