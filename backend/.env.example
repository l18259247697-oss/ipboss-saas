# ===== 一键追爆 SaaS 环境配置（复制为 .env 后填写）=====
# 这些值也可以登录后在【后台-设置】里改，无需改文件。

# --- 大模型 API（用于"改写文案"，OpenAI 兼容即可）---
# 豆包/DeepSeek/通义/Moonshot/OpenAI 等都兼容，填对应的 base_url 和 model
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# --- 现有人物视频改口型：百炼北京地域 ---
# Key 也可只填写在 backend/.env.local，缺配置时阻止生成，不交付占位片。
LS_PROVIDER=dashscope
DASHSCOPE_API_KEY=

# --- 链接原视频转写：可选云端 ASR，复用百炼北京 Key ---
# 默认 local 使用 Whisper small；dashscope 使用音频本身识别，不用标题补文案。
ASR_PROVIDER=local
ASR_MODEL=qwen-audio-3.0-asr-flash

# --- 克隆自己的声音：千问 3.0 Plus，复用上面的百炼北京 Key ---
VC_PROVIDER=dashscope
VC_API_KEY=
VC_MODEL=qwen-audio-3.0-tts-plus
# 原硅基流动可手动选回：VC_PROVIDER=siliconflow，VC_MODEL=FunAudioLLM/CosyVoice2-0.5B
# VC_API_KEY 仅供硅基流动使用，不会发送给百炼。

# --- 计费 ---
CREDITS_PER_VIDEO=10
REGISTER_BONUS=30

# --- 上传保护（按字节限制，避免单个请求占满磁盘）---
MAX_VOICE_UPLOAD_BYTES=52428800
MAX_FACE_UPLOAD_BYTES=314572800
JOB_MAX_CONCURRENCY=1

# 生产 HTTPS 时设为 1，让登录 Cookie 只通过 HTTPS 发送
COOKIE_SECURE=0

# --- 管理员账号（首次启动自动创建）---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin888
